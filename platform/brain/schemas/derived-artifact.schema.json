{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dossiermind.local/schemas/derived-artifact.v1.json",
  "title": "DossierMind Derived Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "tenant_id", "artifact_type", "lineage_id", "evidence_ids", "content_ref",
    "generation", "policy_version", "created_at", "review_status", "independent_evidence"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "artifact_type": { "enum": ["answer", "summary", "report", "export"] },
    "lineage_id": { "type": "string", "minLength": 1 },
    "evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "content_ref": { "type": "string", "minLength": 1 },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "component_version", "contract_version"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "component_version": { "type": "string", "minLength": 1 },
        "contract_version": { "type": "string", "minLength": 1 },
        "model_id": { "type": ["string", "null"] },
        "prompt_template_version": { "type": ["string", "null"] }
      }
    },
    "policy_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "review_status": { "enum": ["not_required", "pending", "approved", "rejected"] },
    "independent_evidence": { "const": false },
    "supersedes_id": { "type": ["string", "null"] },
    "manifest_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
  }
}
