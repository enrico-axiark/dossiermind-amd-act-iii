{
  "name": "dossiermind-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "bootstrap": "node --env-file-if-exists=.env scripts/bootstrap-event.mjs",
    "test": "node --test",
    "check": "node --check src/server.mjs",
    "security-check": "node scripts/security-check.mjs"
  }
}
